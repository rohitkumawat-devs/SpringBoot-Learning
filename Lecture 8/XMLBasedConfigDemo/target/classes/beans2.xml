       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="upiPaymentService" class="in.coderarmy.payment.UPIPaymentService"/>
    <bean id="cardPaymentService" class="in.coderarmy.payment.CardPaymentService"/>
    <bean id="orderService" class="in.coderarmy.OrderService">
